# Las VITE_SUPABASE_* las usa el cliente (todos los trabajadores), viajan en
# el bundle público a propósito -- ver SEGURIDAD_PENDIENTE.md.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-CLAVE-ANON-PUBLICA
# Sin prefijo VITE_ = server-only, solo la ven las funciones serverless de
# api/ (recuperar-clave.js, crear-clave-inicial.js) -- nunca viaja al
# navegador. Es la clave "service_role" de Supabase (Project Settings >
# API Keys) -- se salta RLS por completo, tratarla con cuidado.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role
